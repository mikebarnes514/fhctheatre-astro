---
import ShowLayout from '../layouts/ShowLayout.astro';
---

<ShowLayout>
  <img slot="showImage" src="/images/improv-central-logo.jpg" alt="Improv Central 2026 Fall Edition" width="400px" />
  <h2 slot="showTitle">Improv Central 2026 Fall Edition</h2>
  <div slot="showCopy">
    <p>
      Improv Central kicks off the school year with a night of completely unscripted comedy. Nothing is rehearsed—every scene, character, and punchline is made up on the spot from audience suggestions.
      Come ready to laugh, throw out ideas, and watch our student performers turn them into something nobody saw coming.
    </p>
  </div>
  <div slot="showDates">Saturday, September 26 @ 7:33 PM<br />FHC Auditorium</div>
  <div slot="showTickets">Tickets $10 for adults, $5 for students<br />Available at lunch or at the door</div>
</ShowLayout>
<script is:inline>
  document.getElementById('nav-improv').classList.add('active');
</script>
