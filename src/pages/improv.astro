---
import ShowLayout from '../layouts/ShowLayout.astro';
---

<ShowLayout>
  <img slot="showImage" src="/images/2026-Improv-Spring-Poster.png" alt="Improv Central Spring Edition - Gotham Nights" width="400px" />
  <h2 slot="showTitle">Improv Central Spring Edition - Gotham Nights</h2>
  <div slot="showCopy">
    <p>
      This spring, Improv Central turns the auditorium into Gotham for one night: capes optional, chaos guaranteed. The show is still 100% improvised—nothing rehearsed, everything invented in the moment—with sketches spun from the audience and a Batman-inspired twist. If you like big characters, bigger laughs, and plots that didn't exist five minutes ago, this is your night.
    </p>
    <p>
      Show starts at 7:33pm. Tickets are $10 for adults and $5 for students. They will be available for purchase at lunch or at the door.
    </p>
  </div>
  <div slot="showDates">Saturday, May 2, 2026 @ 7:33 PM</div>
  <div slot="showTickets">Tickets $10 for adults, $5 for students<br />Available at lunch or at the door</div>
</ShowLayout>
<script is:inline>
  document.getElementById('nav-improv').classList.add('active');
</script>
