---
import BigAnnouncement from '../components/BigAnnouncement.astro';
import ShowLineup from '../components/ShowLineup.astro';
import StandardLayout from '../layouts/StandardLayout.astro';
---

<StandardLayout>
  <section>
    <h2 class="center">Welcome to the Home of FHC Theatre</h2>
    <div class="showAnnouncement">
      <div class="mainImage" class="center">
        <img src="/images/improv-f26/improv-f26-poster.jpg" alt="Improv Central: Fall Edition" />
      </div>
      <div class="announcement">
        <h3 class="showTitle">FHC Theatre Presents Improv Central: Fall Edition!</h3>
        <p class="showDate">Saturday, September 26, 2026 @ 7:33 PM<br />FHC Auditorium</p>
        <div class="showInfo">
          <p>Show starts at 7:33pm sharp! Tickets are $10 for adults and $5 for students. They will be available for purchase at lunch or at the door.</p>
        </div>
      </div>
    </div>
    <ShowLineup />
  </section>
  <style>
    .mainImage {
      text-align: center;
    }
    .showAnnouncement {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1em 0;
    }
    .announcement {
      text-align: center;
      margin-left: 2em;
    }
    .showTitle {
      font-size: var(--h2);
      font-style: var(--headingFont);
    }
    .showDate {
      font-size: var(--h4);
    }
    .showInfo {
      padding: 1em 0;
    }
    .showInfo p + p {
      margin-top: 1em;
    }
    @media screen and (min-width: 870px) {
      .showAnnouncement {
        /* flex-direction: row; */
        padding: 2em 0;
      }
      .mainImage img {
        width: 600px;
        max-width: 600px;
      }
    }
  </style>
</StandardLayout>
