---
import BigAnnouncement from '../components/BigAnnouncement.astro';
import ShowLineup from '../components/ShowLineup.astro';
import StandardLayout from '../layouts/StandardLayout.astro';
---

<StandardLayout>
  <section>
    <h2 class="center">Welcome to the Home of FHC Theatre</h2>
    <div class="showAnnouncement">
      <div class="mainImage">
        <img src="/images/wrinkleintime/wrinkle-large.jpg" alt="FH Theatre Presents: A Wrinkle in Time" />
      </div>
      <div class="announcement">
        <h3 class="showTitle">FHC Theatre Presents: A Wrinkle in Time</h3>
        <p class="showDate">November 12-14, 2026 @ 7:00 PM<br />FHC Auditorium</p>
        <div class="showInfo">
          <p>
            FHC Theatre presents Madeleine L'Engle's beloved adventure, A Wrinkle in Time – a thrilling journey across the cosmos where courage, love, and the strength to be yourself are the only weapons
            against the darkness. Follow Meg Murry, her brilliant brother Charles Wallace, and their friend Calvin as three mysterious guides whisk them through space and time on a desperate search for Meg's
            missing father. When an evil force known as IT threatens to consume entire worlds, an unlikely hero must discover that her greatest power has been inside her all along.
          </p>
          <p>
            Our talented student actors bring L'Engle's unforgettable characters to life in this imaginative stage adaptation that explores themes as timeless as the stars themselves. Witness an epic battle
            between light and shadow, conformity and individuality, fear and love – in one of literature's most celebrated journeys. A story of heart and wonder that will leave you questioning: What would you
            risk to save the ones you love?
          </p>
        </div>
      </div>
    </div>
    <ShowLineup />
  </section>
  <style>
    .mainImage {
      text-align: center;
    }
    .showAnnouncement {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1em 0;
    }
    .announcement {
      text-align: center;
      margin-left: 2em;
    }
    .showTitle {
      font-size: var(--h2);
      font-style: var(--headingFont);
    }
    .showDate {
      font-size: var(--h4);
    }
    .showInfo {
      padding: 1em 0;
    }
    .showInfo p + p {
      margin-top: 1em;
    }
    @media screen and (min-width: 870px) {
      .showAnnouncement {
        /* flex-direction: row; */
        padding: 2em 0;
      }
      .mainImage img {
        width: 300px;
        max-width: 600px;
      }
    }
  </style>
</StandardLayout>
