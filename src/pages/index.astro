---
import BigAnnouncement from '../components/BigAnnouncement.astro';
import ShowLineup from '../components/ShowLineup.astro';
import StandardLayout from '../layouts/StandardLayout.astro';
---

<StandardLayout>
  <section>
    <h2 class="center">Welcome to the Home of FHC Theatre</h2>
    <div class="showAnnouncement">
      <div class="mainImage" class="center">
        <img src="/images/improv-spring-2025.jpg" alt="FHC Theatre Presents Improv Central: Spring Edition — Gotham Nights" />
      </div>
      <div class="announcement">
        <h3 class="showTitle">FHC Theatre Presents Improv Central: Spring Edition — Gotham Nights</h3>
        <p class="showDate">Saturday, May 2, 2026 @ 7:33 PM<br />FHC Auditorium</p>
        <p class="showInfo">
          This spring, Improv Central turns the auditorium into Gotham for one night: capes optional, chaos guaranteed. The show is still 100% improvised—nothing rehearsed, everything invented in the moment—with sketches spun from the audience and a Batman-inspired twist. If you like big characters, bigger laughs, and plots that didn't exist five minutes ago, this is your night.
        </p>
        <p>Show starts at 7:33pm. Tickets are $10 for adults and $5 for students. They will be available for purchase at lunch or at the door.</p>
      </div>
    </div>
    <ShowLineup />
  </section>
  <style>
    .mainImage {
      text-align: center;
    }
    .showAnnouncement {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1em 0;
    }
    .announcement {
      text-align: center;
      margin-left: 2em;
    }
    .showTitle {
      font-size: var(--h2);
      font-style: var(--headingFont);
    }
    .showDate {
      font-size: var(--h4);
    }
    .showInfo {
      padding: 1em 0;
    }
    @media screen and (min-width: 870px) {
      .showAnnouncement {
        flex-direction: row;
        padding: 2em 0;
      }
      .mainImage img {
        width: 400px;
        max-width: 400px;
      }
    }
  </style>
</StandardLayout>
