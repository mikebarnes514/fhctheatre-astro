---
import BigAnnouncement from '../components/BigAnnouncement.astro';
import ShowLineup from '../components/ShowLineup.astro';
import StandardLayout from '../layouts/StandardLayout.astro';
---

<StandardLayout>
  <section>
    <h2 class="center">Welcome to the Home of FHC Theatre</h2>
    <div class="showAnnouncement">
      <div class="mainImage" class="center">
        <img src="/images/2026-musical-kickline.jpg" alt="The kickline scene from Something Rotten" />
      </div>
      <div class="announcement">
        <!-- <h3 class="showTitle">FHC Theatre Presents Improv Central: Spring Edition — Gotham Nights</h3>
        <p class="showDate">Saturday, May 2, 2026 @ 7:33 PM<br />FHC Auditorium</p> -->
        <div class="showInfo">
          <p>
            Welcome to Forest Hills Central Theatre—home to improv nights, the fall play, Random Acts of Talent, the
            spring musical, and a community of students who build something memorable together every year.
          </p>
          <p>
            Our 2026-27 season kicks off with Improv Central: Fall Edition on September 26th at 7:33 PM in the FHC Auditorium! For more information, please visit the <a href="/improv">Improv Central</a> page.
          </p>
        </div>
        <!-- <p>Show starts at 7:33pm. Tickets are $10 for adults and $5 for students. They will be available for purchase at lunch or at the door.</p> -->
      </div>
      <BigAnnouncement title="Fall Play Audtions">
        <div slot="copy">
          <p>Auditions for the Fall Play, A Wrinkle in Time, will be held on Tuesday, September 15th and Wednesday, September 16th right after school. Callbacks will be held on Thursday, September 17th.</p>
          <p>We will also be holding an Audition Workshop for students on Monday, September 14th from 3:00 PM to 4:00 PM in the FHC Auditorium. Come meet Ms. Haan and learn about the audition process and what to expect!</p>
        </div>
      </BigAnnouncement>
    </div>
    <ShowLineup />
  </section>
  <style>
    .mainImage {
      text-align: center;
    }
    .showAnnouncement {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1em 0;
    }
    .announcement {
      text-align: center;
      margin-left: 2em;
    }
    .showTitle {
      font-size: var(--h2);
      font-style: var(--headingFont);
    }
    .showDate {
      font-size: var(--h4);
    }
    .showInfo {
      padding: 1em 0;
    }
    .showInfo p + p {
      margin-top: 1em;
    }
    @media screen and (min-width: 870px) {
      .showAnnouncement {
        /* flex-direction: row; */
        padding: 2em 0;
      }
      .mainImage img {
        width: 600px;
        max-width: 600px;
      }
    }
  </style>
</StandardLayout>
