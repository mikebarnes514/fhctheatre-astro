---
import BigAnnouncement from '../components/BigAnnouncement.astro';
import ShowLineup from '../components/ShowLineup.astro';
import StandardLayout from '../layouts/StandardLayout.astro';
---

<StandardLayout>
  <section>
    <h2 class="center">Welcome to the Home of FHC Theatre</h2>
    <div class="showAnnouncement">
      <div class="mainImage" class="center">
        <img src="/images/something-rotten-logo.jpg" alt="FHC Theatre Presents Something Rotten" />
      </div>
      <div class="announcement">
        <h3 class="showTitle">FHC Theatre Presents Something Rotten</h3>
        <p class="showDate">March 19 - 21, 2026 @ 7:00 PM<br />March 21 @ 3:00 PM<br />Forest Hills Fine Arts Center</p>
        <p class="showInfo">
          Something Rotten! is a hilarious and irreverent musical comedy that takes a fresh, modern look at the world of Shakespearean theatre. Set in the 1590s, this show follows the story of two
          brothers, Nick and Nigel Bottom, who are desperate to write a hit play. When they discover that Shakespeare is about to write his own play, they decide to steal the idea and write the first-ever
          musical. Along the way, they encounter a cast of larger-than-life characters, including a scheming rival playwright, a beautiful actress, and a group of bumbling actors. With a mix of classic
          songs and original tunes, "Something Rotten!" is a celebration of the power of creativity and the importance of following your dreams.
        </p>
        <p>Shows start at 7:00pm with a Saturday matinee at 3:00pm. Tickets are $14 and will be available for purchase at the <a href="/tickets">Forest Hills Fine Arts Center Box Office.</a></p>
      </div>
    </div>
    <BigAnnouncement title="Something Rotten Ticket Presale!">
      <div slot="copy">
        <p>Hey parents! Tickets for all performances are now available for purchase as part of an exclusive presale through the Forest Hills Fine Arts Center. The presale will run from February 2nd to February 6th only, so don't wait!</p>
        <p>Tickets must be purchased online at <a href="https://fhfac.ludus.com/200516056" target="_blank">FAC Tickets</a> and require a passcode for access. All parents should have already received the link and passcode in an email from TAC, so if you haven't received it, please contact us.</p>
      </div>
    </BigAnnouncement>
    <ShowLineup />
  </section>
  <style>
    .mainImage {
      text-align: center;
    }
    .showAnnouncement {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1em 0;
    }
    .announcement {
      text-align: center;
      margin-left: 2em;
    }
    .showTitle {
      font-size: var(--h2);
      font-style: var(--headingFont);
    }
    .showDate {
      font-size: var(--h4);
    }
    .showInfo {
      padding: 1em 0;
    }
    @media screen and (min-width: 870px) {
      .showAnnouncement {
        flex-direction: row;
        padding: 2em 0;
      }
      .mainImage img {
        width: 400px;
        max-width: 400px;
      }
    }
  </style>
</StandardLayout>
